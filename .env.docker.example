# ============================================================
# Variables de Entorno para Docker Compose (.env)
# ============================================================

# Django Secret & Modo Debug
SECRET_KEY=django-insecure-prod-key-replace-me-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=*

# Orígenes Permitidos para CORS
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=*

# ============================================================
# Conexión a Base de Datos Externa (PostgreSQL)
# ============================================================
# NOTA:
# - Si tu BD está en tu máquina física (fuera de Docker): usa DB_HOST=host.docker.internal
# - Si tu BD está en la nube o en otro servidor: usa la IP o dominio correspondiente
DB_ENGINE=postgresql
DB_NAME=genai_security_db
DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=host.docker.internal
DB_PORT=5432
RUN_MIGRATIONS=true

# ============================================================
# Frontend (URL que el navegador del usuario usará para contactar el backend)
# ============================================================
VITE_API_URL=http://localhost:8000/api

# ============================================================
# Integraciones Opcionales (Stripe, AI, Email)
# ============================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
AI_MICROSERVICE_URL=http://host.docker.internal:8001/api
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_password
